// nekozame-mac fastfetch: the bubble logo (an image in ghostty and kitty, text
// elsewhere) and nekozame pink
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "auto", "source": "@SHARE@/fastfetch/logo.png", "width": 30, "padding": { "top": 1, "right": 2 } },
    "display": { "separator": "  ", "color": { "keys": "38;2;255;192;229", "title": "38;2;255;192;229" } },
    "modules": [
        "title",
        "break",
        { "type": "os", "key": " 󰣛" },
        { "type": "command", "key": " 󰀵", "text": "echo nekozame-mac" },
        { "type": "kernel", "key": " " },
        { "type": "uptime", "key": " 󰅐" },
        "break",
        { "type": "host", "key": " 󰾰" },
        { "type": "cpu", "key": " 󰻠" },
        { "type": "gpu", "key": " 󰍛" },
        { "type": "memory", "key": " " },
        { "type": "disk", "key": " " },
        { "type": "display", "key": " 󰍹" },
        "break",
        { "type": "wm", "key": " " },
        { "type": "shell", "key": " " },
        { "type": "terminal", "key": " " },
        { "type": "packages", "key": " 󰏖" },
        "break",
        { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
    ]
}
