#!/usr/bin/env python3
"""kitty-logo IMAGE COLUMNS: an image as text, for fastfetch's logo.

sends the image to the terminal (kitty graphics, through tmux when inside it)
and prints the path of a file with the rows of placeholder characters that show
it, then COLUMNS and ROWS: fastfetch prints those as its logo. the picture is
tied to the characters, so inside tmux it stays with its tab, scrolls with the
text, and comes back when you switch back (ghostty and kitty draw it).
"""
import base64, fcntl, os, struct, sys, termios, zlib

# kitty's row/column diacritics (gen/rowcolumn-diacritics.txt), enough for 60 cells
DIACRITICS = [0x0305,0x030D,0x030E,0x0310,0x0312,0x033D,0x033E,0x033F,0x0346,0x034A,0x034B,0x034C,0x0350,0x0351,0x0352,0x0357,0x035B,0x0363,0x0364,0x0365,0x0366,0x0367,0x0368,0x0369,0x036A,0x036B,0x036C,0x036D,0x036E,0x036F,0x0483,0x0484,0x0485,0x0486,0x0487,0x0592,0x0593,0x0594,0x0595,0x0597,0x0598,0x0599,0x059C,0x059D,0x059E,0x059F,0x05A0,0x05A1,0x05A8,0x05A9,0x05AB,0x05AC,0x05AF,0x05C4,0x0610,0x0611,0x0612,0x0613,0x0614,0x0615]
PLACEHOLDER = "\U0010EEEE"

def cell_ratio():
    """cell height / width in pixels, from the terminal (2.0 if it won't say)"""
    for fd in (sys.stdout.fileno(), 0):
        try:
            rows, cols, xp, yp = struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
            if xp and yp and cols and rows:
                return (yp / rows) / (xp / cols)
        except OSError:
            pass
    return 2.0

def png_size(data):
    return struct.unpack(">II", data[16:24])

def main():
    image, cols = os.path.expanduser(sys.argv[1]), min(int(sys.argv[2]), len(DIACRITICS))
    data = open(image, "rb").read()
    w, h = png_size(data)
    rows = max(1, min(len(DIACRITICS), round(cols * h / w / cell_ratio())))
    in_tmux = bool(os.environ.get("TMUX"))
    image_id = (zlib.crc32(data) & 0xFFFFFF) or 1
    cache = os.path.expanduser("~/.cache/kitty-logo")
    os.makedirs(cache, exist_ok=True)
    out = os.path.join(cache, f"{image_id:06x}-{cols}x{rows}.txt")
    # the image itself: straight to the terminal (it's far too big to be part of a
    # logo line), in 4k pieces
    def apc(body):  # one kitty graphics command, through tmux when inside it
        cmd = f"\033_G{body}\033\\"
        return f"\033Ptmux;{cmd.replace(chr(27), chr(27) * 2)}\033\\" if in_tmux else cmd
    payload = base64.b64encode(data).decode()
    chunks = [payload[i:i + 4096] for i in range(0, len(payload), 4096)]
    with open("/dev/tty", "w") as tty:
        for n, chunk in enumerate(chunks):
            more = 1 if n < len(chunks) - 1 else 0
            if n == 0:  # transmit, with a virtual placement shown by the characters
                tty.write(apc(f"a=T,U=1,f=100,q=2,i={image_id},c={cols},r={rows},m={more};{chunk}"))
            else:
                tty.write(apc(f"m={more};{chunk}"))
    # the characters that show it, coloured with the image's id
    if not os.path.exists(out):
        r, g, b = image_id >> 16, (image_id >> 8) & 255, image_id & 255
        with open(out, "w") as f:
            for row in range(rows):
                cells = "".join(PLACEHOLDER + chr(DIACRITICS[row]) + chr(DIACRITICS[col]) for col in range(cols))
                f.write(f"\033[38;2;{r};{g};{b}m{cells}\033[39m\n")
    print(out, cols, rows)

main()
