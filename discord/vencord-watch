#!/bin/bash
# Vencord back into Discord after Discord updates itself (an update replaces the files Vencord
# hooks into, and Discord comes back black, without its theme). setup.sh runs this from a
# login agent: when Discord's files change, and every 15 minutes. Only where Vencord was set
# up before. If Discord only just started (it restarts itself after updating), it's restarted
# once more so the theme is back straight away; otherwise it takes from Discord's next start.
APP=/Applications/Discord.app
RES="$APP/Contents/Resources"
[ -d "$APP" ] && [ -d "$HOME/Library/Application Support/Vencord" ] || exit 0
[ -f "$RES/_app.asar" ] && exit 0  # still in
# what it did goes to a log, so a failure can be looked at
LOG="$HOME/Library/Logs/nekozame-vencord.log"
exec >>"$LOG" 2>&1
echo "$(date '+%F %T') Discord $(defaults read "$APP/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null): Vencord missing, putting it back"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# a few tries: right after waking or logging in the network may not be up yet
done=""
for try in 1 2 3 4 5; do
    if curl -fsSL -o "$tmp/vencord" https://github.com/Vendicated/VencordInstaller/releases/latest/download/VencordInstallerCli-darwin &&
        chmod +x "$tmp/vencord" && "$tmp/vencord" -install -location "$APP" </dev/null; then
        done=1
        break
    fi
    echo "try $try failed"
    sleep 30
done
if [ -z "$done" ]; then
    osascript -e 'display notification "Run ~/.local/share/nekozame-mac/discord/vencord-watch in a terminal, or see ~/Library/Logs/nekozame-vencord.log" with title "Vencord couldn'"'"'t go back into Discord"'
    exit 1
fi
echo "$(date '+%F %T') done"
pid=$(pgrep -x Discord | head -1)
if [ -n "$pid" ]; then
    # how long it's been running, in seconds (macOS's ps only gives [[dd-]hh:]mm:ss)
    up=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ' | awk -F'[-:]' '{s=0; for (i=1; i<=NF; i++) s=s*60+$i; if (NF==4) s=$1*86400+$2*3600+$3*60+$4; print s}')
    if [ -n "$up" ] && [ "$up" -lt 300 ]; then
        osascript -e 'quit app "Discord"'
        for _ in $(seq 20); do pgrep -x Discord >/dev/null || break; sleep 1; done
        open -a Discord
    fi
fi
