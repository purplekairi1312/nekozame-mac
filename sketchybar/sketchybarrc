#!/bin/bash
# nekozame-mac: the bar, like dankmaterialshell's in nekozame os. spaces on the
# left, the focused app (click it for its menus), what's playing, then volume and
# the clock. the macOS menu bar stays hidden, under this one.
P="$CONFIG_DIR/plugins"
BG=0xff5a4f6e       # Crowning
PANEL=0xff4f4562    # Roman Purple
DEEP=0xff433a55     # Purple Velvet
PINK=0xffffc0e5     # Pretty in Pink
TEXT=0xffffffff
DIM=0xffb3a7cb      # Wisteria-Wise

sketchybar --bar position=top height=34 color=$BG corner_radius=12 margin=8 y_offset=6 \
                 border_width=2 border_color=$DEEP shadow=on sticky=on topmost=on

sketchybar --default icon.font="Hack Nerd Font:Bold:15.0" label.font="Hack Nerd Font:Bold:13.0" \
                     icon.color=$TEXT label.color=$TEXT padding_left=4 padding_right=4 \
                     icon.padding_left=6 icon.padding_right=4 label.padding_left=4 label.padding_right=8 \
                     background.color=$PANEL background.corner_radius=8 background.height=24

# spaces 1-9: the current one in pink
for i in 1 2 3 4 5 6 7 8 9; do
    sketchybar --add space space.$i left \
               --set space.$i space=$i icon=$i label.drawing=off \
                     icon.highlight_color=$DEEP background.drawing=off \
                     script="$P/space.sh" click_script="hs -c 'spoon.PaperWM.actions.actions().switch_space_$i()'"
done
sketchybar --add item front_app left \
           --set front_app icon.drawing=off label.color=$PINK background.drawing=off script="$P/front_app.sh" \
                 click_script="hs -c 'nekozameAppMenu()'" \
           --subscribe front_app front_app_switched

sketchybar --add item clock right \
           --set clock update_freq=10 icon=󰥔 icon.color=$PINK script="$P/clock.sh" \
           --add item volume right \
           --set volume icon.color=$PINK script="$P/volume.sh" \
                 click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'" \
           --subscribe volume volume_change mouse.scrolled \
           --add item media right \
           --set media icon=󰎈 icon.color=$PINK label.max_chars=40 scroll_texts=on update_freq=3 \
                 script="$P/media.sh" click_script="media-control toggle-play-pause"

sketchybar --update
